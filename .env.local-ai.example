# Free local AI. Copy to .env for a fresh setup, or copy its AI settings into your existing .env.
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://screening_app:app@127.0.0.1:55432/screening
DATABASE_SYSTEM_URL=postgresql+asyncpg://screening_system:system@127.0.0.1:55432/screening
DB_POOL_SIZE=5
JWT_SECRET=local-development-jwt-secret-change-before-deploy
PII_HASH_KEY=local-development-pii-key-change-before-deploy
BLOB_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"
BLOB_CONTAINER=resumes

# Explicit local selection ignores Azure AI credentials. No API key required.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=shortlist-local:v1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=2048
OLLAMA_KEEP_ALIVE=2m
# Model-server capacity (restart `scripts/local_ai.py serve` after changing). Raise on a GPU machine.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_EMBED_CHUNK_BYTES=1500
EXTRACTION_MODE=llm
SEMANTIC_BACKEND=embeddings
# template skips the second model call per resume (about a minute on a laptop CPU); scores are unchanged.
EXPLANATION_MODE=llm
SEMANTIC_RERANKER=none
LLM_TIMEOUT_S=600
LLM_MAX_RETRIES=1
LLM_BACKOFF_BASE_S=1
EXTRACTION_CACHE_ENABLED=true
EXTRACTION_CACHE_DIR=.cache/extractions

# Tesseract language weights are downloaded by scripts/local_ai.py setup.
OCR_PROVIDER=tesseract
TESSERACT_DATA_DIR=.cache/local-ai/tessdata
TESSERACT_LANGUAGE=eng
TESSERACT_DPI=200
OCR_MAX_PAGES=30
OCR_MAX_PAGE_PIXELS=20000000
OCR_TIMEOUT_S=120

# Conservative defaults for an 8 GB RAM computer; requests are processed serially.
SCREEN_MAX_WORKERS=1
WORKER_CONCURRENCY=1
QUEUE_LOCK_TIMEOUT_S=3600
WORKER_POLL_INTERVAL_S=1
WORKER_SHUTDOWN_TIMEOUT_S=30
RETENTION_SWEEP_HOUR_UTC=2
LOG_LEVEL=INFO
LOG_JSON=true
