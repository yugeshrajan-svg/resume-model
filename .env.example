# Local development only. Copy this file to .env; it is ignored by Git.
# The services run on localhost; the Python API/worker runs on the host.
APP_ENV=dev

# PostgreSQL roles created by infra/postgres/init.sql (Docker or scripts/local_pg.py).
DATABASE_URL=postgresql+asyncpg://screening_app:app@127.0.0.1:55432/screening
DATABASE_SYSTEM_URL=postgresql+asyncpg://screening_system:system@127.0.0.1:55432/screening
DB_POOL_SIZE=10

# Fixed development keys let separate API/worker processes agree across restarts.
# Replace both keys with independently generated random secrets before deployment.
JWT_SECRET=local-development-jwt-secret-change-before-deploy
PII_HASH_KEY=local-development-pii-key-change-before-deploy

# Public Azurite development account/key; this is not an Azure cloud credential.
BLOB_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"
BLOB_CONTAINER=resumes
SAS_TTL_S=600

# The default setup makes no calls to Azure OpenAI or Document Intelligence.
LLM_PROVIDER=azure_openai
EXTRACTION_MODE=rules
SEMANTIC_BACKEND=tfidf
SEMANTIC_RERANKER=none
EXTRACTION_CACHE_ENABLED=true
EXTRACTION_CACHE_DIR=.cache/extractions
SCREEN_MAX_WORKERS=4

# For free local language models, embeddings and OCR, use .env.local-ai.example
# and follow docs/free-local-ai.md. No Azure AI key is needed.

# To enable Azure OpenAI, set your credentials and switch the two modes above to
# EXTRACTION_MODE=llm and SEMANTIC_BACKEND=embeddings.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-key
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_CHAT_DEPLOYMENT=your-chat-deployment
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment

# Optional OCR for scanned PDFs. Unconfigured scans are marked needs_reprocess.
# AZURE_DOCINTEL_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_DOCINTEL_KEY=your-key
OCR_TIMEOUT_S=120

# API_KEY applies to the current engine API (api.main:app).
# Leave it commented to disable shared-key authentication locally.
# API_KEY=your-local-api-key
MAX_FILE_BYTES=5242880
MAX_FILES_PER_REQUEST=100
MAX_JD_CHARS=50000
MAX_STORED_JOBS=500

QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_BASE_S=5
QUEUE_LOCK_TIMEOUT_S=900
WORKER_POLL_INTERVAL_S=1
WORKER_CONCURRENCY=4
WORKER_SHUTDOWN_TIMEOUT_S=30
RETENTION_SWEEP_HOUR_UTC=2

FAIRNESS_SCOPE=ci
LOG_LEVEL=INFO
LOG_JSON=true
